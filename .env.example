# Morning Hub Command Center — Environment Variables
# Copy this file to .env.local and fill in your values
# All integrations are optional — the app works with placeholders until configured

# ─── Supabase (Database) ────────────────────────────────
# Create a free project at https://supabase.com
# Then run supabase/migrations/001_initial_schema.sql in the SQL editor
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ─── Todoist (Task Sync) ────────────────────────────────
# Get your token at https://app.todoist.com/app/settings/integrations/developer
TODOIST_API_TOKEN=

# ─── Google Calendar ────────────────────────────────────
# Create a service account at https://console.cloud.google.com
# Enable Calendar API, share your calendar with the service account email
GOOGLE_CALENDAR_CREDENTIALS=
GOOGLE_CALENDAR_ID=primary

# ─── AI Providers (for summaries, tagging, confrontation) ─
# Gemini (bulk processing): https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Claude (synthesis/reviews): https://console.anthropic.com
ANTHROPIC_API_KEY=

# OpenAI Whisper (voice): https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ─── Google Drive (NotebookLM export) ───────────────────
# Same service account as Calendar, enable Drive API
GOOGLE_DRIVE_FOLDER_ID=

# ─── YouTube Data API ───────────────────────────────────
# Enable YouTube Data API v3 in Google Cloud Console
YOUTUBE_API_KEY=
